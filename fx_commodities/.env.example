# ── MT5 broker connection ───────────────────────────────────────────────────
# Terminal must be installed and logged in on this (Windows) machine.
MT5_TERMINAL_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

# Identifies this bot's orders; never touch positions with a different magic.
MAGIC=520025

# Canonical key → your broker's symbol name (check Market Watch for suffixes
# like EURUSD.r / XAUUSDm and adjust).
SYMBOL_MAP=EURUSD=EURUSD,GBPUSD=GBPUSD,USDJPY=USDJPY,XAUUSD=XAUUSD,XAGUSD=XAGUSD,WTI=USOIL,NATGAS=NATGAS,COPPER=COPPER

# ── Capital (D5 low-capital profile) ────────────────────────────────────────
# Account currency. With $1000 and 1% risk, each trade risks $10.
CAPITAL_TOTAL=1000
ALLOC_FX_COMMODITIES=1.0
RISK_PER_TRADE_PCT=1.0
MAX_DAILY_LOSS_PCT=2.0
MAX_DAILY_LOSS_PER_SYMBOL_PCT=1.0
MAX_LOTS=0.10
MAX_OPEN_POSITIONS=2
MAX_CORRELATED_POSITIONS=1
MAX_TRADES_PER_DAY=2
KELLY_FRACTION=0.5

# ── Universe / sessions ─────────────────────────────────────────────────────
UNIVERSE=EURUSD,GBPUSD,USDJPY,XAUUSD,XAGUSD,WTI,NATGAS,COPPER
MAX_MEDIAN_SPREAD_PCT_FX=0.03
MAX_MEDIAN_SPREAD_PCT_CMD=0.06
MAX_LIVE_SPREAD_PCT=0.08
ALLOW_OVERNIGHT=false
SQUARE_OFF_MIN_BEFORE_SWAP=15
SKIP_MIN_AFTER_OPEN=30

# ── Strategy / model (D5 high-win-rate profile: inverted barriers) ─────────
# Breakeven p* = (SL + cost)/(PT + SL) ≈ 0.73; entry needs p ≥ p* + EDGE_MARGIN
BAR_INTERVAL_S=60
PT_MULT=0.8
SL_MULT=1.6
MAX_HOLD_BARS=60
EDGE_MARGIN=0.07
PRIMARY_DELTA=0.03
CONFORMAL_EPS=0.15
IMBALANCE_RATIO=3.0
TRAIL_MULT=1.5
KALMAN_Q=1e-5
KALMAN_R=1e-2
EMBARGO_PCT=0.01
HMM_STATES=3
HMM_WINDOW_BARS=2000
HAR_REFIT_DAYS=7
FFD_ADF_ALPHA=0.05
DRIFT_PSI_WARN=0.25
DRIFT_PSI_FEATURES_BLOCK=6

# ── Data ────────────────────────────────────────────────────────────────────
DATA_ROOT=./data_root
FLUSH_INTERVAL_S=60
POLL_INTERVAL_MS=200
DOM_SNAPSHOT_INTERVAL_MS=500

# ── Costs (verify against your broker's contract terms) ───────────────────
COMMISSION_PER_LOT_SIDE=3.5
DEFAULT_SLIPPAGE_POINTS=2

# ── Ops ─────────────────────────────────────────────────────────────────────
ALERT_WEBHOOK_URL=
SIGNAL_WEBHOOK_URL=
HEALTH_PORT=8081
JOURNAL_PATH=./journal.db
REPORTS_DIR=./reports
LOG_LEVEL=INFO
