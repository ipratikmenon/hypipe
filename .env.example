# Dhan API credentials — copy to .env and fill in your values
DHAN_CLIENT_ID=your_client_id_here
DHAN_ACCESS_TOKEN=your_access_token_here

# Instrument to trade (Dhan security_id for the options contract)
# Example: NIFTY 26 MAY 25000 CALL
SECURITY_ID=49081
EXCHANGE_SEGMENT=NSE_FNO
INSTRUMENT_TYPE=OPTIDX
TRADING_SYMBOL=NIFTY26MAY2525000CE

# Order sizing
QUANTITY=1
PRODUCT_TYPE=INTRADAY

# Risk management
MAX_LOSS_PER_TRADE=500
MAX_DAILY_LOSS=2000
PROFIT_TARGET_MULTIPLIER=2.0

# Strategy parameters (candle timeframe in minutes)
CANDLE_INTERVAL=2
DEMA_FAST=10
DEMA_SLOW=20
DEMA_TREND=95

# Timezone
TIMEZONE=Asia/Kolkata

# Market hours (IST 24h format)
MARKET_OPEN=09:15
MARKET_CLOSE=15:30
TRADE_CUTOFF=15:15
