# ── Dhan API credentials ───────────────────────────────────────────────────
# Get these from dhan.co → API section
DHAN_CLIENT_ID=your_client_id_here
DHAN_ACCESS_TOKEN=your_access_token_here

# ── Indices to trade ───────────────────────────────────────────────────────
# Comma-separated list — leave blank or set all four:
# NIFTY, BANKNIFTY, MIDCPNIFTY, FINNIFTY
INDICES=NIFTY,BANKNIFTY,MIDCPNIFTY,FINNIFTY

# Which option types to trade: CE (calls), PE (puts), or both
OPTION_TYPES=CE,PE

# ── Order settings ─────────────────────────────────────────────────────────
PRODUCT_TYPE=INTRADAY

# ── Risk / budget controls ─────────────────────────────────────────────────
# MAX_LOSS_PER_TRADE is your per-trade budget in ₹.
# The algo will only trade options where:  LTP × lot_size ≤ MAX_LOSS_PER_TRADE
# It is also used as the per-trade stop-loss amount.
MAX_LOSS_PER_TRADE=5000

# Total loss for the day before the bot stops trading
MAX_DAILY_LOSS=15000

# Profit target = entry_price + (entry_price - stop_loss) × this multiplier
PROFIT_TARGET_MULTIPLIER=2.0

# ── Strategy parameters ────────────────────────────────────────────────────
CANDLE_INTERVAL=2
DEMA_FAST=10
DEMA_SLOW=20
DEMA_TREND=95

# ── Market hours (IST, 24h) ────────────────────────────────────────────────
TIMEZONE=Asia/Kolkata
MARKET_OPEN=09:15
MARKET_CLOSE=15:30
TRADE_CUTOFF=15:15

# ── Webhook server (webhook_server.py) ────────────────────────────────────
# A random secret string — paste this same value into every TradingView alert
# message JSON as: "secret":"YOUR_VALUE_HERE"
# Leave blank to disable auth check (dev/testing only).
WEBHOOK_SECRET=change_me_to_a_random_string
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8000
